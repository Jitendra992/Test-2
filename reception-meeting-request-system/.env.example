# Copy to .env for local development (optional: everything works without it).
# On Vercel, set these in Project Settings -> Environment Variables.

# Signs the login cookie. Recommended in production:  openssl rand -hex 32
# If unset, local dev uses an insecure built-in secret, and a Vercel deploy
# derives one from the Redis token below.
SESSION_SECRET=

# If set, the very first admin account can only be created by someone who knows
# this token. Strongly recommended for a public deployment.
ADMIN_BOOTSTRAP_TOKEN=

# Port for the local API server (npm run dev). Vite proxies /api to it.
# API_PORT=3001

# Local data file (default: .data/reception.json). Ignored when Redis is configured.
# RECEPTION_DATA_FILE=

# Hosted storage for Vercel: Upstash Redis. Connecting the Upstash integration to
# your Vercel project sets KV_REST_API_URL / KV_REST_API_TOKEN automatically.
# These names also work:
# UPSTASH_REDIS_REST_URL=
# UPSTASH_REDIS_REST_TOKEN=
